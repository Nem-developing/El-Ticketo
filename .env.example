# Copiez ce fichier en .env et renseignez les mots de passe (le fichier .env n'est pas versionné).
# Exemple pour générer un mot de passe : openssl rand -base64 24

# Version à déployer (ex. 3.4). Vide : la dernière.
ELTICKETO_VERSION=

# Port HTTP exposé sur la machine hôte.
HTTP_PORT=8080

# Mot de passe de la base MariaDB (utilisé par la base et par l'API).
DB_PASSWORD=

# Compte administrateur créé au tout premier démarrage (base vide).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Durée de validité d'une session, en heures.
TOKEN_TTL_HOURS=168
