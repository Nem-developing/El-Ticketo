# Copiez ce fichier en .env et renseignez les mots de passe (le fichier .env n'est pas versionné).
# Exemple pour générer un mot de passe : openssl rand -base64 24

# Version à déployer (ex. 3.4). Vide : la dernière.
ELTICKETO_VERSION=

# Port HTTP exposé sur la machine hôte.
HTTP_PORT=8080

# Mot de passe de la base MariaDB (utilisé par la base et par l'API).
DB_PASSWORD=

# Compte administrateur créé au tout premier démarrage (base vide).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Durée de validité d'une session, en heures.
TOKEN_TTL_HOURS=168

# Adresse publique de l'application (liens envoyés par les webhooks, retour du SSO).
# Vide : déduite de chaque requête. À renseigner derrière un proxy TLS, ex. https://tickets.exemple.fr
PUBLIC_URL=

# Connexion unique (SSO) OpenID Connect, facultative : voir « Connexion unique (SSO) » dans le README.
# Adresse de retour à déclarer chez le fournisseur : <PUBLIC_URL>/api/auth/sso/callback
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
